.{
    .name = .fluxion_ai,
    .version = "0.1.0",
    .minimum_zig_version = "0.16.0",
    .fingerprint = 0x7e1bbbe035c7efd2, // Changing this has security and trust implications.
    .dependencies = .{
        .fluxion_json = .{
            .url = "git+https://github.com/kisstp2006/fluxion-json#7e5669d3e6d664e8e66a758dfc3d7a051d2995fe",
            .hash = "fluxion_json-0.1.0-sFlLPSZmBAClbMzerd_OsFdPWO9BhS91ubypyFi7IutG",
        },
        // The examples look at the pictures that come back; the library
        // never does. Lazy, and asked for only when this is the package being
        // built, so a program that depends on fluxion-ai never fetches it.
        .fluxion_image = .{
            .url = "git+https://github.com/kisstp2006/fluxion-image#79463ef201f11e15ada014467c0ad1d58b2a882d",
            .hash = "fluxion_image-0.1.0-fyJkdS7vAAB1p43VSutvpxQB32hIcvJb3fGSZbo_qeha",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "examples",
        "tests",
        "README.md",
        "LICENSE",
    },
}
